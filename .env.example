# MAPIAP frontend environment template.

# Public canonical origin used for SEO metadata, robots.txt and sitemap.xml.
# Leave unset until the official production domain is validated.
NEXT_PUBLIC_SITE_URL=

# Editorial content source.
# "local" keeps the versioned development content in this repository.
# "cms" activates the provider-neutral remote JSON adapter.
CONTENT_SOURCE=local

# Exact remote endpoint used when CONTENT_SOURCE=cms.
# Expected JSON contract:
# {
#   "items": [
#     {
#       "slug": "publication-slug",
#       "title": "Publication title",
#       "excerpt": "Publication excerpt",
#       "body": ["Paragraph 1", "Paragraph 2"],
#       "status": "published" | "draft"
#     }
#   ]
# }
#
# Public requests consume only "published" entries.
# Preview requests append ?preview=1 and may consume draft entries.
CMS_CONTENT_API_URL=

# Optional server-only bearer token for the CMS content endpoint.
CMS_CONTENT_API_TOKEN=

# Server-only secret used by /api/preview?secret=...&slug=...
EDITORIAL_PREVIEW_SECRET=

# Server-only bearer secret used by POST /api/revalidate.
EDITORIAL_REVALIDATION_SECRET=

# Analytics mode:
# - disabled: no consent UI and /api/analytics refuses collection
# - consent: tracking remains blocked until the visitor explicitly accepts
ANALYTICS_MODE=disabled

# Optional server-only endpoint receiving validated analytics events.
# The application does not forward IP addresses, user agents, email addresses
# or query strings as part of its analytics event contract.
ANALYTICS_WEBHOOK_URL=

# Optional server-only endpoint receiving validated contact requests as JSON.
# Leave unset to keep the contact form in explicit "delivery unavailable" mode.
CONTACT_WEBHOOK_URL=
