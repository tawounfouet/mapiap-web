# MAPIAP frontend environment template.

# Public canonical origin used for SEO metadata, robots.txt and sitemap.xml.
# Leave unset until the official production domain is validated.
NEXT_PUBLIC_SITE_URL=

# Editorial content source.
# "local" keeps the versioned development content in this repository.
# "cms" activates the provider-neutral remote JSON adapter.
CONTENT_SOURCE=local

# Published CMS endpoint used when CONTENT_SOURCE=cms.
# Expected JSON contract:
# {
#   "items": [
#     {
#       "slug": "publication-slug",
#       "title": "Publication title",
#       "excerpt": "Publication excerpt",
#       "body": ["Paragraph 1", "Paragraph 2"],
#       "status": "published"
#     }
#   ]
# }
CMS_CONTENT_API_URL=

# Optional server-only bearer token for the published CMS endpoint.
CMS_CONTENT_API_TOKEN=

# Optional dedicated preview endpoint used by Draft Mode.
# Expected JSON contract:
# {
#   "item": {
#     "slug": "publication-slug",
#     "title": "Draft title",
#     "excerpt": "Draft excerpt",
#     "body": ["Draft paragraph"],
#     "status": "draft"
#   }
# }
CMS_CONTENT_PREVIEW_API_URL=

# Optional server-only bearer token dedicated to preview content.
# Falls back to CMS_CONTENT_API_TOKEN when omitted.
CMS_CONTENT_PREVIEW_API_TOKEN=

# Server-only secret required by /api/preview.
CMS_PREVIEW_SECRET=

# Server-only secret required in the x-mapiap-revalidate-secret header.
CMS_REVALIDATE_SECRET=

# Optional server-only endpoint receiving validated contact requests as JSON.
# Leave unset to keep the contact form in explicit "delivery unavailable" mode.
CONTACT_WEBHOOK_URL=
